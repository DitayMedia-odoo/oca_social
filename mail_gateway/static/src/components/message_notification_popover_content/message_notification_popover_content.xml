<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Odoo 19 renamed `notification.persona` to `notification.res_partner_id`
         and split the popover in two loops (non-follower and follower
         notifications); both need the gateway branch. -->
    <t t-inherit="mail.MessageNotificationPopover" t-inherit-mode="extension">
        <xpath
            expr="//div[@t-foreach='otherNotifications']/span[@t-if='notification.res_partner_id']"
            position="after"
        >
            <span
                t-elif="notification.notification_type == 'gateway'"
                t-esc="notification.channel_name"
            />
        </xpath>
        <xpath
            expr="//div[@t-foreach='followerNotifications']/span[@t-if='notification.res_partner_id']"
            position="after"
        >
            <span
                t-elif="notification.notification_type == 'gateway'"
                t-esc="notification.channel_name"
            />
        </xpath>
    </t>
</templates>
